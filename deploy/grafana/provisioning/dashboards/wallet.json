{
  "title": "wallet-go",
  "uid": "wallet-go",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/s by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(wallet_http_requests_total[1m])) by (route, status)",
          "legendFormat": "{{route}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP latency (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(wallet_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(wallet_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(wallet_http_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transfers completed/s (success vs. replay)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(wallet_transfers_total[1m])) by (endpoint, replayed)",
          "legendFormat": "{{endpoint}} replayed={{replayed}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Business errors/s by code",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(wallet_business_errors_total[1m])) by (code)",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Outbox pending events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wallet_outbox_pending_events",
          "legendFormat": "pending"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wallet_outbox_oldest_pending_age_seconds",
          "legendFormat": "oldest age (s)"
        }
      ]
    },
    {
      "id": 6,
      "title": "DB pool saturation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wallet_db_pool_acquired_conns",
          "legendFormat": "acquired"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wallet_db_pool_idle_conns",
          "legendFormat": "idle"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "wallet_db_pool_max_conns",
          "legendFormat": "max"
        }
      ]
    },
    {
      "id": 7,
      "title": "Relay: events published/s by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(wallet_relay_published_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    }
  ]
}
