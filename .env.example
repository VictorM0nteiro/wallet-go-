# wallet_app is the least-privilege role (migration 000002); migrations
# themselves run as wallet, the schema owner. See docker-compose.yml.
DATABASE_URL=postgres://wallet_app:wallet_app_dev@localhost:5432/wallet?sslmode=disable
WALLET_API_KEY=dev-key
# Optional. A second key that can only read (balance, entries): anything
# else answers 403. Leave unset to disable the scope check entirely.
# WALLET_API_KEY_READONLY=dev-read-key
LISTEN_ADDR=:8080
WALLET_TRANSFER_STRATEGY=locking
WALLET_DB_MAX_CONNS=30