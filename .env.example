# wallet_app is the least-privilege role (migration 000002); migrations
# themselves run as wallet, the schema owner. See docker-compose.yml.
DATABASE_URL=postgres://wallet_app:wallet_app_dev@localhost:5432/wallet?sslmode=disable
WALLET_API_KEY=dev-key
# Optional. A second key that can only read (balance, entries): anything
# else answers 403. Leave unset to disable the scope check entirely.
# WALLET_API_KEY_READONLY=dev-read-key
LISTEN_ADDR=:8080
WALLET_TRANSFER_STRATEGY=locking
WALLET_DB_MAX_CONNS=30
# Optional. > 0 turns on elastic pool resizing (docs/adr/0009-elastic-db-pool.md):
# the pool starts at this floor and grows toward WALLET_DB_MAX_CONNS under
# sustained load, shrinking back down when idle. Leave unset for a fixed pool.
# WALLET_DB_MIN_CONNS=5
# Per-API-key token bucket (docs/adr/0006-rate-limiting-per-api-key.md). 0
# disables it -- needed to reproduce docs/bench/RESULTS.md with cmd/loadtest.
WALLET_RATE_LIMIT_RPS=50
WALLET_RATE_LIMIT_BURST=100
# cmd/relay only (docs/adr/0007-outbox-relay-no-broker.md). It connects as
# wallet_relay, not wallet_app -- override DATABASE_URL when running it, see
# docs/running-locally.md.
# RELAY_POLL_INTERVAL=1s
# RELAY_BATCH_SIZE=20